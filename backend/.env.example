# Required for a running API. Must connect using the least-privilege 'safetyspell_app' role in production.
# (Migrations run separately via one-off container using 'safetyspell_admin' / owner credentials).
DATABASE_URL=postgres://safetyspell_app:app_password@localhost:5432/safetyspell
# Required only when running the destructive, database-backed integration suite.
# Point this at a dedicated disposable database; tests ignore DATABASE_URL when this is set.
INTEGRATION_DATABASE_URL=postgres://safetyspell:safetyspell@localhost:5432/safetyspell_integration
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
# Required in production for scan-log IP pseudonymisation. In non-production, absence safely omits IP-derived logging.
SCAN_LOG_IP_HMAC_SECRET=replace-with-a-separate-at-least-32-random-characters
PORT=3001
# Comma-separated browser origins allowed to call this local API. Never use *.
FRONTEND_ORIGIN=http://localhost:5173

# Redis Rate Limiter configuration (Phase 6 Slice 1)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-strong-redis-password

# Trusted Proxy Hops (default 1 behind single Hostinger Traefik reverse proxy)
TRUST_PROXY_HOPS=1
