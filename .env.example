# Local-only Core API address for the demo-gated frontend.
# Do not place credentials or secrets in VITE_ variables.
VITE_CORE_API_URL=http://localhost:3001

# Base URL of the public, login-free scan web. QR codes encode <base>/scan?tag=<code>.
# Dev defaults to the local frontend origin; set the real domain in production.
VITE_PUBLIC_SCAN_BASE_URL=http://localhost:8080

# Environment mode: 'development' | 'production'.
# When set to 'production', the demo banner (<DemoGate />) is hidden for pilot/production deployments.
VITE_ENVIRONMENT=development

